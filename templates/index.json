    "main_faq_p33ian": {
      "type": "main-faq",
      "blocks": {
        "question_Bqkt89": {
          "type": "question",
          "settings": {
            "question_faqs": "Are all Lumière Botanica products 100% clean and vegan?",
            "answer_faqs": "<p>Yes. Every formulation is 100% vegan, cruelty-free certified, and free from synthetic fragrances, parabens, sulfates, phthalates, and mineral oils.</p>"
          }
        },
        "question_yTWzpq": {
          "type": "question",
          "settings": {
            "question_faqs": "How should I layer my serums and moisturizers?",
            "answer_faqs": "<p>We recommend applying products from thinnest to thickest texture: cleanse, mist, apply water-based serums, lock in hydration with your cream, and finish with facial oil.</p>"
          }
        },
        "question_mqpEBD": {
          "type": "question",
          "settings": {
            "question_faqs": "Are your products suitable for sensitive and reactive skin?",
            "answer_faqs": "<p>Absolutely. Our formulas are dermatologist-tested and formulated at optimal pH levels with soothing botanicals like calendula, squalane, and chamomile to support delicate skin.</p>"
          }
        },
        "question_ARtapR": {
          "type": "question",
          "settings": {
            "question_faqs": "How does your eco-friendly packaging work?",
            "answer_faqs": "<p>We package in recyclable amber glass to protect active ingredients from UV light, use post-consumer recycled boxes, and print with soy-based biodegradable inks.</p>"
          }
        },
        "question_9FJ77Q": {
          "type": "question",
          "settings": {
            "question_faqs": "What is your return and satisfaction policy?",
            "answer_faqs": "<p>We offer a 30-day happiness guarantee. If a product isn't the perfect fit for your skin, reach out to our concierge team for a hassle-free exchange or full refund.</p>"
          }
        }
      },
